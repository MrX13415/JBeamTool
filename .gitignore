# Basic .gitignore for C# / .NET projects used with VSCode

# Build outputs
[Bb]in/
[Oo]bj/
bin/
obj/

# VS/VSCode
.vs/
.vscode/

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates

# NuGet packages & lock/assets
*.nupkg
packages/
project.lock.json
project.assets.json
.nuget/

# Build logs and test results
*.log
TestResults/

# IDE/cache folders
.idea/
_ReSharper*/
.vscode-test/

# OS files
.DS_Store
Thumbs.db