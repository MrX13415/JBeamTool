<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0</AssemblyVersion>
    <FileVersion>0.5.0</FileVersion>
    <ProductName>JBeamTool</ProductName>
    <Authors>MrX13415</Authors>
    <Description>CLI validator and localization manager for BeamNG JBeam vehicle definition files</Description>
    <!-- Both Debug and Release: single self-contained executable -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Release: strip debug info and trim for smaller size -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- Debug: include debug info -->
    <DebugType Condition="'$(Configuration)' == 'Debug'">embedded</DebugType>
    <!-- Suppress trimming warnings for JSON serialization of anonymous types -->
    <!-- These are acceptable since we control all serialized types at compile time -->
    <NoWarn Condition="'$(Configuration)' == 'Release'">$(NoWarn);IL2026;IL2075;IL2087</NoWarn>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
